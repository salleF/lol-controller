# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.spec
# ...but keep the committed PyInstaller build spec (see README "Build").
!lolcontroller.spec

# Virtual environments
.venv/
venv/
env/

# Editors / IDEs
.vscode/
.idea/

# Per-user runtime config (auto-generated by config.py on first run —
# each user/machine gets their own, should never be committed)
user_config.json

# OS cruft
Thumbs.db
.DS_Store
